# 1. IMPORTS
import streamlit as st
import faiss
import pickle
import numpy as np
from sentence_transformers import SentenceTransformer

#2. PAGE CONFIG
st.set_page_config(page_title="Chatbot", layout="wide")

#3. CUSTOM CSS 
st.markdown(
    """
    <style>
    /* Optional styling for chat input area */
    div[data-testid="stChatInput"] {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    div[data-testid="stChatInput"] > div {
        flex: 1;
    }

    .chat-messages-label {
        font-weight: bold;
        margin-bottom: 5px;
    }
    </style>
    """,
    unsafe_allow_html=True
)

#LOAD MODEL + DATA
model = SentenceTransformer('all-MiniLM-L6-v2')
index = faiss.read_index("index.faiss")

with open("chunks.pkl", "rb") as f:
    chunks = pickle.load(f)

#SEARCH FUNCTION
def search(query):
    query_vec = model.encode([query])
    D, I = index.search(np.array(query_vec).astype("float32"), k=3)
    return [chunks[i] for i in I[0]]

# TITLE
st.title("🤖 Website Chatbot")

#SESSION MEMORY
if "messages" not in st.session_state:
    st.session_state.messages = []

#DISPLAY CHAT HISTORY LABEL
st.markdown('<div class="chat-messages-label"></div>', unsafe_allow_html=True)
for msg in st.session_state.messages:
    st.chat_message(msg["role"]).write(msg["content"])

#INPUT BAR (TEXT ONLY)
prompt = st.chat_input("Ask anything about the website...")  # Text input

#HANDLE TEXT INPUT
if prompt:
    # Add user message
    st.session_state.messages.append({"role": "user", "content": prompt})
    st.chat_message("user").write(prompt)

    # Search the index
    results = search(prompt)
    answer = " ".join(results[:2])  # Top 2 results for concise answer

    # Add assistant message
    st.session_state.messages.append({"role": "assistant", "content": answer})
    st.chat_message("assistant").write(answer)